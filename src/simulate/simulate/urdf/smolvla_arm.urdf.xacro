        </camera>
        <plugin name="wrist_camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>${robot_namespace}</namespace>
            <remapping>wrist_camera/image_raw:=camera/wrist/image_raw</remapping>
            <remapping>wrist_camera/camera_info:=camera/wrist/camera_info</remapping>
          </ros>
          <camera_name>wrist_camera</camera_name>
          <frame_name>${prefix}wrist_camera_optical_frame</frame_name>
