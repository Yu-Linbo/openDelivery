# robot_name / current_map / robot_status / task_status: empty string = leave unchanged.
# rate_hz <= 0 means leave publish_rate unchanged.
# task_progress: -1.0 = leave unchanged; 0.0-1.0 sets the progress value.
#
# robot_status: initializing | localizing | localization_lost | ready | shutdown
# task_status: idle | mapping | delivery | cleaning | patrolling
string robot_name
string current_map
string robot_status
string task_status
float64 rate_hz
float64 task_progress
---
bool success
string message
